<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <!-- Hardened-runtime builds only (CODE_SIGN_IDENTITY set): lets modules
         send Apple Events, e.g. BootCaptain reading login items through
         System Events. Each send still asks the user (Automation consent). -->
    <key>com.apple.security.automation.apple-events</key><true/>
</dict></plist>
